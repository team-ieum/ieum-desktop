{
  "nodes": [
    {"id": "t", "type": "TRIGGER", "event": "local.folder_new_file", "label": "다운로드 새 파일", "config": {"folder": "/Users/me/Downloads"}},
    {"id": "c", "type": "CONDITION", "event": "branch.if", "label": "이미지만", "config": {"otherwise": "stop", "branches": [
      {"key": "b_00000001", "name": "이미지", "rules": [{"left": "{{nodes.t.output.extension}}", "operator": "equals", "right": "png"}]}
    ]}},
    {"id": "x1", "type": "ACTION", "event": "local.file_rename", "label": "이름 바꾸기", "config": {"path": "{{nodes.t.output.path}}", "newName": "사진.png"}},
    {"id": "x2", "type": "ACTION", "event": "local.file_trash", "label": "버리기", "config": {"path": "{{nodes.t.output.path}}"}}
  ],
  "edges": [
    {"id": "e0", "source": "t", "target": "c"},
    {"id": "e1", "source": "c", "target": "x1", "conditionType": "b_00000001"},
    {"id": "e2", "source": "c", "target": "x2", "conditionType": "else"}
  ]
}

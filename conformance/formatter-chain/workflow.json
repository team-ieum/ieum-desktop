{
  "nodes": [
    {"id": "t", "type": "TRIGGER", "event": "local.folder_new_file", "label": "새 파일", "config": {"folder": "/Users/me/Downloads"}},
    {"id": "f1", "type": "TRANSFORM", "event": "formatter.text_trim", "label": "공백 정리", "config": {"input": "{{nodes.t.output.name}}"}},
    {"id": "f2", "type": "TRANSFORM", "event": "formatter.text_case", "label": "대소문자", "config": {"input": "{{nodes.f1.output.output}}"}},
    {"id": "c", "type": "CONDITION", "event": "branch.if", "label": "이름 확인", "config": {"caseSensitive": true, "otherwise": "stop", "branches": [{"key": "b_00000001", "name": "보고서", "rules": [{"left": "{{nodes.f2.output.output}}", "operator": "equals", "right": "Quarterly Report.pdf"}]}]}},
    {"id": "m", "type": "ACTION", "event": "local.file_move", "label": "옮기기", "config": {"path": "{{nodes.t.output.path}}", "baseFolder": "/Users/me/Sorted", "destination": "{{nodes.f2.output.output}}"}}
  ],
  "edges": [
    {"id": "e1", "source": "t", "target": "f1"},
    {"id": "e2", "source": "f1", "target": "f2"},
    {"id": "e3", "source": "f2", "target": "c"},
    {"id": "e4", "source": "c", "target": "m", "conditionType": "b_00000001"}
  ]
}

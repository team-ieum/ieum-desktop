{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "화면(main 창)이 쓰는 앱 명령·이벤트·폴더 고르기·자동 시작 상태만",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-workflows",
    "allow-save-workflow",
    "allow-delete-workflow",
    "allow-validate-workflow",
    "allow-run-now",
    "allow-list-runs",
    "allow-get-run",
    "allow-undo-run",
    "allow-detect-providers",
    "allow-set-api-key",
    "allow-delete-api-key",
    "allow-get-settings",
    "allow-set-settings",
    "allow-web-login",
    "allow-web-logout",
    "allow-web-account",
    "dialog:allow-open",
    "autostart:allow-is-enabled"
  ]
}

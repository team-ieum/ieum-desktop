{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "화면(main 창)이 쓰는 앱 명령·이벤트·폴더 고르기만",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "allow-list-workflows",
    "allow-save-workflow",
    "allow-delete-workflow",
    "allow-validate-workflow",
    "allow-run-now",
    "allow-list-runs",
    "allow-get-run",
    "allow-undo-run",
    "allow-detect-providers",
    "allow-set-api-key",
    "allow-delete-api-key",
    "allow-keychain-status",
    "allow-open-web-editor",
    "allow-get-settings",
    "allow-set-settings",
    "allow-web-login",
    "allow-web-logout",
    "allow-web-account",
    "allow-web-list-workflows",
    "allow-web-get-workflow",
    "allow-web-list-executions",
    "allow-web-execution-logs",
    "allow-web-watch-execution",
    "allow-web-unwatch-execution",
    "dialog:allow-open"
  ]
}
